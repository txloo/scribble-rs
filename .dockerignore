# Build context for the dev/test image in ./Dockerfile.
#
# Unlike upstream's whitelist .dockerignore (which drops *_test.go so the
# scratch release build stays lean), this one keeps test files: the dev/test
# container is expected to run `go test -race ./...` against the source.

# VCS metadata - the image never needs it, and -buildvcs=false is set
.git
.github

# Authoring tool state
.opencode
.opencode_data

# Editor / IDE state
.vscode
.idea

# Locally hosted files (see .gitignore - fly.io/fly.toml mount these)
public

# Build output
scribblers
*.exe
__debug_bin

# Profiling output
*.pprof
*.out
